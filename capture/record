#!/bin/bash

###################################################################
# Script Name	: Record (record)
# Description	: Records section of a screen.
#		  When called second time the process gets killed, handy for a keybinding.
# Args		: $1 - filename
# Dependencies	: slop-wayland, date
# Variables	:
# Author	: Mateusz Reszka
# Email		: mateusz@mateuszreszka.xyz
###################################################################

if ( pgrep -c wf-recorder > /dev/null ); then
    pkill wf-recorder
    nots "Recording stopped!"
    exit 0
fi

filename="$HOME/Videos/screencast/$(date +"%Y-%m-%dT%H-%M-%S").mkv"

[ -n "$1" ] && filename="$1"
[ -f "$filename" ] && rm "$filename"

nots "Recording started!"
wf-recorder --geometry "$(slurp)" --file="$filename"
